{
  "name": "@poki/cli",
  "version": "0.2.0",
  "description": "Poki for Developers command line utility",
  "keywords": [
    "cli",
    "poki"
  ],
  "homepage": "https://github.com/poki/poki-cli",
  "bugs": {
    "url": "https://github.com/poki/poki-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poki/poki-cli.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "ISC",
  "files": [
    "bin/index.js"
  ],
  "bin": {
    "poki": "bin/index.js"
  },
  "scripts": {
    "cli": "node bin/index.js",
    "lint": "ts-standard src test scripts rollup.config.mjs --fix",
    "lint:check": "ts-standard src test scripts rollup.config.mjs",
    "test": "node scripts/test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "audit:dependencies": "yarn audit",
    "typecheck": "tsc --noEmit",
    "validate:source": "yarn lint:check && yarn typecheck && yarn test",
    "validate": "yarn validate:source && yarn test:package && yarn build",
    "release:validate": "yarn validate:source && yarn build && yarn audit:dependencies",
    "release:check": "yarn release:validate && yarn test:package --require-clean",
    "release:publish": "yarn release:validate && yarn test:package --require-clean --publish",
    "build": "rollup -c rollup.config.mjs",
    "prepack": "yarn build",
    "prepublishOnly": "yarn release:check"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "form-data": "^4.0.6",
    "open": "^11.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@toon-format/toon": "^4.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/yargs": "^17.0.35",
    "rollup": "^4.59.0",
    "semver": "^7.7.4",
    "ts-standard": "^12.0.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.7.0"
  }
}
